# 华北 2（北京）按量付费 API Key 使用下面的 Base URL。
# 如果使用新加坡、美国或业务空间专属域名，请同时更换同地域 API Key。
DASHSCOPE_API_KEY=replace-me
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# HolmesGPT 对未收录模型默认预留 64K 输出；百炼 qwen-plus 需显式限制。
HOLMES_MAX_OUTPUT_TOKENS=8192

# 部署脚本会在服务器首次部署时自动生成随机 API 访问密钥。
HOLMES_API_KEY=generated-on-server
TZ=Asia/Shanghai
